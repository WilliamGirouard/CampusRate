{
  "info": {
    "name": "CampusRate",
    "description": "Manual test scenarios for the CampusRate API — covers CRUD for places and reviews, filtering, pagination, error handling (Problem Details), and business rule validation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1", "type": "string" },
    { "key": "placeId", "value": "", "type": "string" },
    { "key": "reviewId", "value": "", "type": "string" },
    { "key": "persistenceTestPlaceId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Create a Place",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Location header is present', function () {",
              "    pm.response.to.have.header('Location');",
              "});",
              "const body = pm.response.json();",
              "pm.test('averageRating is null and reviewCount is 0', function () {",
              "    pm.expect(body.averageRating).to.equal(null);",
              "    pm.expect(body.reviewCount).to.equal(0);",
              "});",
              "pm.collectionVariables.set('placeId', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Main Library\",\n  \"description\": \"Huge library with many books.\",\n  \"category\": \"STUDY_SPACE\",\n  \"address\": \"Building L, Local L-505\",\n  \"services\": [\"WIFI\", \"POWER_OUTLETS\"]\n}"
        },
        "url": { "raw": "{{baseUrl}}/places", "host": ["{{baseUrl}}"], "path": ["places"] }
      }
    },
    {
      "name": "2. Get the Created Place",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Returned place matches created id', function () {",
              "    pm.expect(pm.response.json().id).to.equal(pm.collectionVariables.get('placeId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/places/{{placeId}}", "host": ["{{baseUrl}}"], "path": ["places", "{{placeId}}"] }
      }
    },
    {
      "name": "3. Create a Review for the Place",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Location header is present', function () {",
              "    pm.response.to.have.header('Location');",
              "});",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('reviewId', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"authorName\": \"Samira\",\n  \"rating\": 4,\n  \"comment\": \"Calme et Wi-Fi stable, tres bon endroit pour etudier.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/places/{{placeId}}/reviews",
          "host": ["{{baseUrl}}"],
          "path": ["places", "{{placeId}}", "reviews"]
        }
      }
    },
    {
      "name": "4. Get the Created Review",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Returned review matches created id', function () {",
              "    pm.expect(pm.response.json().id).to.equal(pm.collectionVariables.get('reviewId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/reviews/{{reviewId}}", "host": ["{{baseUrl}}"], "path": ["reviews", "{{reviewId}}"] }
      }
    },
    {
      "name": "5. Verify Place Statistics Updated",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('averageRating and reviewCount reflect the new review', function () {",
              "    pm.expect(body.averageRating).to.equal(4);",
              "    pm.expect(body.reviewCount).to.equal(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/places/{{placeId}}", "host": ["{{baseUrl}}"], "path": ["places", "{{placeId}}"] }
      }
    },
    {
      "name": "6. Update the Place (PATCH)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Status field was updated', function () {",
              "    pm.expect(pm.response.json().status).to.equal('INACTIVE');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"INACTIVE\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/places/{{placeId}}", "host": ["{{baseUrl}}"], "path": ["places", "{{placeId}}"] }
      }
    },
    {
      "name": "7. Invalid Rating Returns 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('Response is Problem Details format', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('type');",
              "    pm.expect(body).to.have.property('title');",
              "    pm.expect(body).to.have.property('status', 400);",
              "    pm.expect(body).to.have.property('detail');",
              "    pm.expect(body).to.have.property('instance');",
              "});",
              "pm.test('Content-Type is application/problem+json', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"authorName\": \"Invalid Rater\",\n  \"rating\": 9,\n  \"comment\": \"This rating is out of range.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/places/{{placeId}}/reviews",
          "host": ["{{baseUrl}}"],
          "path": ["places", "{{placeId}}", "reviews"]
        }
      }
    },
    {
      "name": "8. Non-Existent Resource Returns 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 404', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "pm.test('Response is Problem Details format', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('status', 404);",
              "    pm.expect(body).to.have.property('detail');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/places/plc_doesnotexist",
          "host": ["{{baseUrl}}"],
          "path": ["places", "plc_doesnotexist"]
        }
      }
    },
    {
      "name": "9. Delete Conflict When Place Has Reviews (409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 409', function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "pm.test('Response is Problem Details format', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('status', 409);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": { "raw": "{{baseUrl}}/places/{{placeId}}", "host": ["{{baseUrl}}"], "path": ["places", "{{placeId}}"] }
      }
    },
    {
      "name": "10. Delete the Review (Allowed)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 204', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": { "raw": "{{baseUrl}}/reviews/{{reviewId}}", "host": ["{{baseUrl}}"], "path": ["reviews", "{{reviewId}}"] }
      }
    },
    {
      "name": "11. Delete the Place (Now Allowed, No Reviews Left)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 204', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": { "raw": "{{baseUrl}}/places/{{placeId}}", "host": ["{{baseUrl}}"], "path": ["places", "{{placeId}}"] }
      }
    },
    {
      "name": "12. Filter Places by Category",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response has data and pagination', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('data');",
              "    pm.expect(body).to.have.property('pagination');",
              "});",
              "pm.test('All results match the requested category', function () {",
              "    const body = pm.response.json();",
              "    body.data.forEach((place) => {",
              "        pm.expect(place.category).to.equal('STUDY_SPACE');",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/places?category=STUDY_SPACE",
          "host": ["{{baseUrl}}"],
          "path": ["places"],
          "query": [{ "key": "category", "value": "STUDY_SPACE" }]
        }
      }
    },
    {
      "name": "13. Paginate the Places Collection",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Pagination metadata is correct', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.pagination.page).to.equal(1);",
              "    pm.expect(body.pagination.limit).to.equal(5);",
              "    pm.expect(body.data.length).to.be.at.most(5);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/places?page=1&limit=5",
          "host": ["{{baseUrl}}"],
          "path": ["places"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "5" }
          ]
        }
      }
    },
    {
      "name": "14. Empty Collection Returns Empty Array (Not an Error)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Data is an empty array when no match', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.data).to.be.an('array').that.is.empty;",
              "    pm.expect(body.pagination.totalItems).to.equal(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/places?category=FOOD_SERVICE&page=999",
          "host": ["{{baseUrl}}"],
          "path": ["places"],
          "query": [
            { "key": "category", "value": "FOOD_SERVICE" },
            { "key": "page", "value": "999" }
          ]
        }
      }
    },
    {
      "name": "15. Create a Place for the Persistence Test",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.collectionVariables.set('persistenceTestPlaceId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Persistence Test Room\",\n  \"description\": \"Created solely to verify data survives a server restart.\",\n  \"category\": \"STUDY_SPACE\",\n  \"address\": \"Building P, Local P-100\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/places", "host": ["{{baseUrl}}"], "path": ["places"] }
      }
    },
    {
      "name": "16. Verify Persistence After Restart (Manual Step)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('The place created before restart still exists', function () {",
              "    pm.expect(pm.response.json().id).to.equal(pm.collectionVariables.get('persistenceTestPlaceId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "description": "MANUAL STEP: Before running this request, stop the server (Ctrl+C), restart it with `npm run start`, then send this request. It checks that the place created in step 15 is still present after the restart.",
        "url": {
          "raw": "{{baseUrl}}/places/{{persistenceTestPlaceId}}",
          "host": ["{{baseUrl}}"],
          "path": ["places", "{{persistenceTestPlaceId}}"]
        }
      }
    }
  ]
}
