      },
      "delete": {
        "description": "Delete an existing review and recalculate the statistics",
        "operationId": "ReviewsController_deleteOneReviewById_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "The review's ID",
            "schema": {
              "example": "rvw_01JABC123",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Review deleted"
          },
          "404": {
            "description": "Review not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
