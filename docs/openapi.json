{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1": {
      "get": {
        "operationId": "AppController_getHello_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "App"
        ]
      }
    },
    "/api/v1/places": {
      "get": {
        "description": "Return the collection of places filtered and paginated",
        "operationId": "PlacesController_findAllPlaces_v1",
        "parameters": [
          {
            "name": "category",
            "required": true,
            "in": "query",
            "description": "Place Category filter",
            "schema": {
              "example": "STUDY_SPACE",
              "type": "string",
              "enum": [
                "STUDY_SPACE",
                "LIBRARY",
                "FOOD_SERVICE",
                "SPORTS",
                "STUDENT_SERVICE",
                "COMPUTER_LAB"
              ]
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Place pagination number (Current page number)",
            "schema": {
              "default": 1,
              "example": 3,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "The limit of places per pages (how many places per page)",
            "schema": {
              "minimum": 1,
              "maximum": 25,
              "default": 10,
              "example": 5,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of places",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueriedPlacesResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid category, page or limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "List places",
        "tags": [
          "Places"
        ]
      },
      "post": {
        "description": "Create a new place and add it to the list of places",
        "operationId": "PlacesController_createOnePlace_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePlaceDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Place has been created",
            "headers": {
              "Location": {
                "description": "URI of the created Place",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "Create a place",
        "tags": [
          "Places"
        ]
      }
    },
    "/api/v1/places/{id}": {
      "get": {
        "description": "Returns one place by given id",
        "operationId": "PlacesController_findOnePlaceById_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "The place's ID",
            "schema": {
              "example": "plc_01JABC123",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Place found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Place not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "Get info on one place",
        "tags": [
          "Places"
        ]
      },
      "patch": {
        "description": "Partially update an existing place",
        "operationId": "PlacesController_updateOnePlace_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "The place's ID",
            "schema": {
              "example": "plc_01JABC123",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePlaceDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Place modified",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "404": {
            "description": "Place not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "Update a place",
        "tags": [
          "Places"
        ]
      },
      "delete": {
        "description": "Delete an existing place that has no reviews",
        "operationId": "PlacesController_deleteOnePlaceById_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "The place's ID",
            "schema": {
              "example": "plc_01JABC123",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Place deleted"
          },
          "404": {
            "description": "Place not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "409": {
            "description": "The place you want to delete has reviews, thus it cannot be deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "Delete a place",
        "tags": [
          "Places"
        ]
      }
    },
    "/api/v1/reviews/{id}": {
